# Generated locally by scripts/bootstrap-local-databases.ps1.
# Never commit the generated .env or any administrator database credential.
CHATBI_META_PASSWORD=<GENERATED_LOCAL_APP_PASSWORD>
CHATBI_DATASOURCE_SECRET_KEY=<GENERATED_LOCAL_ENCRYPTION_KEY>
CHATBI_RAG_SHARED_SECRET=<GENERATED_LOCAL_RAG_BRIDGE_SIGNING_KEY>
CHATBI_BOOTSTRAP_ADMIN_PASSWORD=<GENERATED_LOCAL_ADMIN_LOGIN_PASSWORD>
CHATBI_BOOTSTRAP_ANALYST_PASSWORD=<GENERATED_LOCAL_ANALYST_LOGIN_PASSWORD>
CHATBI_DEMO_POSTGRES_PASSWORD=<GENERATED_LOCAL_READER_PASSWORD>
CHATBI_DEMO_MYSQL_PASSWORD=<GENERATED_LOCAL_READER_PASSWORD>

# Optional OpenAI-compatible NL2SQL provider. Keep deterministic for an offline demo.
CHATBI_MODEL_PROVIDER=deterministic
CHATBI_MODEL_BASE_URL=
CHATBI_MODEL_API_KEY=
CHATBI_MODEL_NAME=

# Named external providers. Credentials stay server-side and are never returned to the browser.
CHATBI_KIMI_BASE_URL=https://api.moonshot.cn/v1
CHATBI_KIMI_API_KEY=
CHATBI_KIMI_MODEL_NAME=kimi-k2.6
CHATBI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
CHATBI_MIMO_API_KEY=
CHATBI_MIMO_MODEL_NAME=mimo-v2.5
CHATBI_DEEPSEEK_BASE_URL=https://api.deepseek.com
CHATBI_DEEPSEEK_API_KEY=
CHATBI_DEEPSEEK_MODEL_NAME=deepseek-v4-flash
CHATBI_QUERY_TIMEOUT_MS=8000
CHATBI_QUERY_ROW_LIMIT=500
CHATBI_QUERY_CONCURRENCY=4
CHATBI_CONTEXT_TOKEN_BUDGET=6000

# Required V1 live RAG and bounded orchestration. Keep signing material server-side.
CHATBI_RAG_MODE=on
CHATBI_AGENT_MODE=on
CHATBI_AGENT_ALLOWED_ROUTES=COMPLEX_ANALYSIS
CHATBI_RAG_FALLBACK_ENABLED=true
CHATBI_AGENT_FALLBACK_ENABLED=true
CHATBI_LEGACY_RAG_BASE_URL=http://rag-runtime:8001
CHATBI_LEGACY_RAG_BEARER_TOKEN=
CHATBI_LEGACY_RAG_REQUIRE_WORKSPACE_ECHO=true
CHATBI_LEGACY_AGENT_BASE_URL=
CHATBI_LEGACY_AGENT_BEARER_TOKEN=
CHATBI_AGENT_TIMEOUT_MS=30000
CHATBI_AGENT_MAX_STEPS=8
CHATBI_AGENT_MAX_TOOL_CALLS=12
CHATBI_AGENT_MAX_REPLAN=2
CHATBI_AGENT_MAX_DEPTH=2
CHATBI_AGENT_TOKEN_BUDGET=6000

# Authenticated sessions and temporary attachment processing.
CHATBI_SESSION_TTL_MINUTES=480
CHATBI_REMEMBER_SESSION_TTL_DAYS=30
CHATBI_SESSION_COOKIE_SECURE=false
CHATBI_ATTACHMENT_MAX_BYTES=26214400
CHATBI_ATTACHMENT_MAX_ROWS=100000
CHATBI_ATTACHMENT_TEXT_MAX_CHARS=200000
CHATBI_ATTACHMENT_TTL_HOURS=24
CHATBI_GENERAL_MODEL_PROVIDER=auto
CHATBI_VISION_MODEL_PROVIDER=auto
CHATBI_VISION_MODEL_NAME=
