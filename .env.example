# ChatBI V2 enterprise-oriented local/private deployment template.
# Classification: REQUIRED / OPTIONAL / DEFAULT / LOCAL_DEPLOYMENT / ENTERPRISE_OVERRIDE.
# Copy this file to .env, configure PostgreSQL, then run scripts/bootstrap.ps1.
# bootstrap.ps1 replaces only the GENERATED placeholders below. Never commit .env.

# Deployment identity and published ports (DEFAULT / ENTERPRISE_OVERRIDE).
COMPOSE_PROJECT_NAME=chatbi-v2
CHATBI_BACKEND_IMAGE=
CHATBI_SANDBOX_IMAGE=
CHATBI_DEPLOYMENT_MODE=local
CHATBI_ENVIRONMENT=local
CHATBI_FRONTEND_PORT=5173
CHATBI_BACKEND_PORT=8000
CHATBI_RAG_PORT=8001
CHATBI_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Metadata PostgreSQL (REQUIRED).
# The hostname must be reachable from Docker. For PostgreSQL on this Windows host,
# use host.docker.internal, never localhost. Use an application role, not postgres.
CHATBI_DATABASE_URL=<REQUIRED_POSTGRESQL+PSYCOPG_URL>
# Required for isolated-schema deployments and destructive local reset safeguards.
CHATBI_DATABASE_SCHEMA=
# Legacy LOCAL_DEPLOYMENT fallback used only by bootstrap-local-databases.ps1.
CHATBI_META_PASSWORD=

# Server-side application secrets (REQUIRED; generated once by bootstrap.ps1).
CHATBI_DATASOURCE_SECRET_KEY=<GENERATED_BY_BOOTSTRAP>
CHATBI_RAG_SHARED_SECRET=<GENERATED_BY_BOOTSTRAP>
CHATBI_BOOTSTRAP_ADMIN_PASSWORD=<GENERATED_BY_BOOTSTRAP>
CHATBI_BOOTSTRAP_ANALYST_PASSWORD=<GENERATED_BY_BOOTSTRAP>

# Project-owned bind storage and backups (DEFAULT / ENTERPRISE_OVERRIDE).
CHATBI_STORAGE_ROOT=./.chatbi/storage
CHATBI_BACKUP_ROOT=./.chatbi/backups
CHATBI_ALLOW_METADATA_RESET=NO
CHATBI_ALLOW_EXTERNAL_STORAGE_RESET=NO

# Optional Demo Seed (OPTIONAL; false for an enterprise deployment).
CHATBI_SEED_DEMO_SEMANTIC_MODEL=false
CHATBI_DEMO_POSTGRES_HOST=host.docker.internal
CHATBI_DEMO_POSTGRES_PORT=5432
CHATBI_DEMO_POSTGRES_DATABASE=chatbi_v2
CHATBI_DEMO_POSTGRES_SCHEMA=demo_business
CHATBI_DEMO_POSTGRES_USERNAME=chatbi_reader
CHATBI_DEMO_POSTGRES_PASSWORD=
CHATBI_DEMO_MYSQL_HOST=host.docker.internal
CHATBI_DEMO_MYSQL_PORT=3306
CHATBI_DEMO_MYSQL_DATABASE=chatbi_demo_business
CHATBI_DEMO_MYSQL_USERNAME=chatbi_reader
CHATBI_DEMO_MYSQL_PASSWORD=

# Model routing (OPTIONAL). The base application starts with no Provider key.
# auto falls back to the deterministic local NL2SQL runtime when no key is set.
CHATBI_MODEL_PROVIDER=auto
CHATBI_GENERAL_MODEL_PROVIDER=auto
CHATBI_VISION_MODEL_PROVIDER=auto
CHATBI_MODEL_BUDGET_MODE=balanced
CHATBI_MODEL_BASE_URL=
CHATBI_MODEL_API_KEY=
CHATBI_MODEL_NAME=
CHATBI_KIMI_BASE_URL=https://api.moonshot.cn/v1
CHATBI_KIMI_API_KEY=
CHATBI_KIMI_MODEL_NAME=kimi-k2.6
CHATBI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
CHATBI_MIMO_API_KEY=
CHATBI_MIMO_MODEL_NAME=mimo-v2.5
CHATBI_DEEPSEEK_BASE_URL=https://api.deepseek.com
CHATBI_DEEPSEEK_API_KEY=
CHATBI_DEEPSEEK_MODEL_NAME=deepseek-v4-flash
CHATBI_VISION_MODEL_NAME=

# Query safety and semantic runtime (DEFAULT / ENTERPRISE_OVERRIDE).
CHATBI_QUERY_TIMEOUT_MS=30000
CHATBI_QUERY_ROW_LIMIT=500
CHATBI_QUERY_CONCURRENCY=4
CHATBI_QUERY_MAX_ESTIMATED_COST=1000000
CHATBI_VERIFICATION_QUERY_ENABLED=true
CHATBI_CONTEXT_TOKEN_BUDGET=6000
CHATBI_SEMANTIC_RUNTIME_MODE=wren
CHATBI_SEMANTIC_UPSTREAM_REUSE_MODE=selected_source

# Governed RAG and bounded orchestration are enabled in V1 (DEFAULT).
CHATBI_RAG_MODE=on
CHATBI_AGENT_MODE=on
CHATBI_AGENT_ALLOWED_ROUTES=COMPLEX_ANALYSIS
CHATBI_RAG_FALLBACK_ENABLED=true
CHATBI_AGENT_FALLBACK_ENABLED=true
CHATBI_LEGACY_RAG_BASE_URL=http://rag-runtime:8001
CHATBI_LEGACY_RAG_BEARER_TOKEN=
CHATBI_LEGACY_RAG_REQUIRE_WORKSPACE_ECHO=true
CHATBI_LEGACY_AGENT_BASE_URL=
CHATBI_LEGACY_AGENT_BEARER_TOKEN=
CHATBI_AGENT_TIMEOUT_MS=30000
CHATBI_AGENT_MAX_STEPS=8
CHATBI_AGENT_MAX_TOOL_CALLS=12
CHATBI_AGENT_MAX_REPLAN=2
CHATBI_AGENT_MAX_DEPTH=2
CHATBI_AGENT_TOKEN_BUDGET=6000

# Sessions, attachments, and sandbox (DEFAULT / ENTERPRISE_OVERRIDE).
CHATBI_SESSION_TTL_MINUTES=480
CHATBI_REMEMBER_SESSION_TTL_DAYS=30
CHATBI_SESSION_COOKIE_SECURE=false
CHATBI_ATTACHMENT_MAX_BYTES=26214400
CHATBI_ATTACHMENT_MAX_ROWS=100000
CHATBI_ATTACHMENT_TEXT_MAX_CHARS=200000
CHATBI_ATTACHMENT_TTL_HOURS=24
CHATBI_DOCKER_SOCKET_PATH=/var/run/docker.sock

# Paid test controls (DEFAULT: no paid Provider calls).
CHATBI_TEST_COST_CONTROL=NO
CHATBI_TEST_EXECUTION_LEVEL=LEVEL0
CHATBI_PAID_GATE_AUTHORIZED=NO
CHATBI_LEVEL0_PAID_EXCEPTION=NO

# Deployment smoke datasource (OPTIONAL; consumed only by scripts/smoke.ps1).
# Supply a read-only account. These values are not passed to the browser.
CHATBI_SMOKE_DATASOURCE_HOST=
CHATBI_SMOKE_DATASOURCE_PORT=5432
CHATBI_SMOKE_DATASOURCE_DATABASE=
CHATBI_SMOKE_DATASOURCE_USERNAME=
CHATBI_SMOKE_DATASOURCE_PASSWORD=
CHATBI_SMOKE_DATASOURCE_SCHEMA=
CHATBI_SMOKE_TABLE=orders
CHATBI_SMOKE_PRIMARY_KEY=order_id
CHATBI_SMOKE_METRIC_COLUMN=revenue
CHATBI_SMOKE_TIME_COLUMN=order_date
CHATBI_SMOKE_DIMENSION_COLUMN=region_id
