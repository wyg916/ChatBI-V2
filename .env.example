# Generated locally by scripts/bootstrap-local-databases.ps1.
# Never commit the generated .env or any administrator database credential.
CHATBI_META_PASSWORD=<GENERATED_LOCAL_APP_PASSWORD>
CHATBI_DATASOURCE_SECRET_KEY=<GENERATED_LOCAL_ENCRYPTION_KEY>
CHATBI_DEMO_POSTGRES_PASSWORD=<GENERATED_LOCAL_READER_PASSWORD>
CHATBI_DEMO_MYSQL_PASSWORD=<GENERATED_LOCAL_READER_PASSWORD>

# Optional OpenAI-compatible NL2SQL provider. Keep deterministic for an offline demo.
CHATBI_MODEL_PROVIDER=deterministic
CHATBI_MODEL_BASE_URL=
CHATBI_MODEL_API_KEY=
CHATBI_MODEL_NAME=
CHATBI_QUERY_TIMEOUT_MS=8000
CHATBI_QUERY_ROW_LIMIT=500
CHATBI_QUERY_CONCURRENCY=4
CHATBI_CONTEXT_TOKEN_BUDGET=6000
